# Redirect uppercase DocBook URLs to lowercase (global fix)
RewriteCond %{REQUEST_URI} [A-Z]
RewriteRule ^(.*)$ /docbook$1 [R=301,L]

# Allow everything else through
RewriteBase /docbook/
RewriteRule ^public/.*$ - [L]
RewriteRule ^(.+?)/?$ public/$1 [L]
